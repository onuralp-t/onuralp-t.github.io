        <span class=3D"kt">int</span> <span class=3D"n">left</span> <span c=
lass=3D"o">=3D</span> <span class=3D"n">end</span> <span class=3D"o">-</spa=
n> <span class=3D"n">src</span><span class=3D"p">;</span>
