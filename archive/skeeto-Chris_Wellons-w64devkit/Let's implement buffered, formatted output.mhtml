lass=3D"highlight"><code><span class=3D"kt">void</span> <span class=3D"nf">=
append</span><span class=3D"p">(</span><span class=3D"k">struct</span> <spa=
n class=3D"n">buf</span> <span class=3D"o">*</span><span class=3D"n">b</spa=
