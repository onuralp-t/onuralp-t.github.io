</span> <span class=3D"n">i</span><span class=3D"p">);</span>
        <span class=3D"n">append_byte</span><span class=3D"p">(</span><span=
 class=3D"o">&amp;</span><span class=3D"n">stdout</span><span class=3D"p">,=
</span> <span class=3D"sc">'\n'</span><span class=3D"p">);</span>
