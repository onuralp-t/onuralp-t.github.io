pan>
<span class=3D"p">{</span>
    <span class=3D"n">b</span><span class=3D"o">-&gt;</span><span class=3D"=
n">error</span> <span class=3D"o">|=3D</span> <span class=3D"n">b</span><sp=
an class=3D"o">-&gt;</span><span class=3D"n">fd</span> <span class=3D"o">&l=
t;</span> <span class=3D"mi">0</span><span class=3D"p">;</span>
    <span class=3D"k">if</span> <span class=3D"p">(</span><span class=3D"o"=
