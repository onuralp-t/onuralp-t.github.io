class=3D"o">=3D</span> <span class=3D"n">b</span><span class=3D"o">-&gt;</s=
pan><span class=3D"n">cap</span> <span class=3D"o">-</span> <span class=3D"=
n">b</span><span class=3D"o">-&gt;</span><span class=3D"n">len</span><span =
class=3D"p">;</span>
