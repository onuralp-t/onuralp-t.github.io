s=3D"n">error</span> <span class=3D"o">&amp;&amp;</span> <span class=3D"n">=
b</span><span class=3D"o">-&gt;</span><span class=3D"n">len</span><span cla=
ss=3D"p">)</span> <span class=3D"p">{</span>
        <span class=3D"n">b</span><span class=3D"o">-&gt;</span><span class=
=3D"n">error</span> <span class=3D"o">|=3D</span> <span class=3D"o">!</span=
><span class=3D"n">os_write</span><span class=3D"p">(</span><span class=3D"=
n">b</span><span class=3D"o">-&gt;</span><span class=3D"n">fd</span><span c=
lass=3D"p">,</span> <span class=3D"n">b</span><span class=3D"o">-&gt;</span=
