t">long</span> <span class=3D"n">i</span> <span class=3D"o">=3D</span> <spa=
n class=3D"mi">0</span><span class=3D"p">;</span> <span class=3D"n">i</span=
> <span class=3D"o">&lt;</span> <span class=3D"mi">1000000</span><span clas=
s=3D"p">;</span> <span class=3D"n">i</span><span class=3D"o">++</span><span=
 class=3D"p">)</span> <span class=3D"p">{</span>
